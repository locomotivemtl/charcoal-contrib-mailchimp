{
    "type": "library",
    "name": "locomotivemtl/charcoal-contrib-mailchimp",
    "description": "Charcoal service provider for Mailchimp implementation.",
    "keywords": [
        "charcoal"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Locomotive",
            "homepage": "https://locomotive.ca"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "charcoal/admin": "^6.0",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "seld/jsonlint": "^1.11",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Charcoal\\": "src/Charcoal/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charcoal\\Tests\\": "tests/Charcoal/"
        }
    },
    "scripts": {
        "fix:phpcbf": "phpcbf -ps --colors",
        "lint": [
            "@lint:json",
            "@lint:php",
            "@lint:phpcs",
            "@lint:phpstan"
        ],
        "lint:json": "find {config,metadata} -type f -iname '*.json' -print0 2> /dev/null | xargs -0 jsonlint -q",
        "lint:php": "find {src,tests} -type f -name '*.php' -print0 2> /dev/null | xargs -0 -n1 -P8 $PHP_BINARY -l | grep -v '^No syntax errors detected'; test $? -eq 1",
        "lint:phpcs": "phpcs -ps --colors",
        "lint:phpstan": "phpstan analyse",
        "test": [
            "@test:phpunit"
        ],
        "test:phpunit": "simple-phpunit"
    },
    "scripts-descriptions": {
        "fix:phpcbf": "Fix syntax violations with PHPCS",
        "lint": "Run all linting tools",
        "lint:php": "Run syntax check with PHP",
        "lint:phpcs": "Run syntax check with PHPCS",
        "lint:phpstan": "Run static code analysis with PHPStan",
        "test": "Run all testing tools",
        "test:phpunit": "Run all tests with PHPUnit"
    },
    "config": {
        "sort-packages": true
    }
}
